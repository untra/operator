#!/usr/bin/env bash
# Committed pre-push hook. Runs the CI-parity gate (`make check`) before any
# push so clippy/fmt/test failures are caught locally instead of on CI.
#
# Enable once per clone:  make install-hooks   (sets core.hooksPath=.githooks)
# Bypass in an emergency:  git push --no-verify
set -euo pipefail

# Resolve the repo root so the hook works regardless of the cwd at push time.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: running 'make check' (fmt + clippy + test)…"
if ! make check; then
	echo
	echo "pre-push: 'make check' failed — push aborted." >&2
	echo "Fix the issues above, or bypass with 'git push --no-verify' (not recommended)." >&2
	exit 1
fi
