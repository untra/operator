{
  "$schema": "tool_config.schema.json",
  "tool_name": "gemini",
  "display_name": "Google Gemini",
  "version_command": "gemini --version",
  "min_version": "0.1.0",
  "capabilities": {
    "supports_sessions": true,
    "supports_headless": true,
    "supports_config_override": true,
    "supports_permission_mode": false
  },
  "model_aliases": [
    "pro",
    "flash",
    "ultra"
  ],
  "arg_mapping": {
    "prompt": "-p",
    "model": "--model",
    "session_id": "--resume",
    "quiet": "--output-format json"
  },
  "command_template": "gemini {{config_flags}}--model {{model}} --resume {{session_id}} \"$(cat {{prompt_file}})\"",
  "yolo_flags": [
    "--auto-approve",
    "-y"
  ],
  "skill_directories": {
    "global": [],
    "project": [
      ".gemini/"
    ]
  },
  "telemetry_env": {
    "GEMINI_TELEMETRY_ENABLED": "true",
    "GEMINI_TELEMETRY_TARGET": "local",
    "GEMINI_TELEMETRY_OTLP_ENDPOINT": "{{otlp_endpoint}}",
    "GEMINI_TELEMETRY_OTLP_PROTOCOL": "http",
    "GEMINI_TELEMETRY_LOG_PROMPTS": "false"
  }
}
