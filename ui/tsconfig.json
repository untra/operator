{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun"],
    "paths": {
      "@operator/bindings/*": ["../bindings/*"],
      "@operator/webcomponents": ["../webcomponents/dist/index.d.ts"]
    }
  },
  "include": ["src"]
}
