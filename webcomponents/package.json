{
  "name": "@operator/webcomponents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared UI components rendered by both the operator SPA (ui/) and the Jekyll docs site (docs/).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run copy-types && vite build -c vite.react.config.ts && tsc -p tsconfig.build.json && vite build -c vite.elements.config.ts",
    "typecheck": "npm run copy-types && tsc --noEmit",
    "typecheck:stories": "npm run copy-types && tsc --noEmit -p tsconfig.storybook.json",
    "test": "npm run copy-types && bun test",
    "test:storybook": "npm run copy-types && vitest --project=storybook --run",
    "storybook": "npm run copy-types && storybook dev -p 6006 --no-open",
    "storybook:build": "npm run copy-types && storybook build --output-dir storybook-static",
    "copy-types": "node scripts/copy-types.mjs",
    "lint": "npm run copy-types && cd .. && bun run lint:webcomponents"
  },
  "dependencies": {
    "@untra/naiveworkflow-react": "0.0.3",
    "@xyflow/react": "^12.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@vscode/codicons": "0.0.45",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "4.1.11"
  }
}
